          "default": 2.0,
          "minimum": 1,
          "title": "Maximum Observed Area Ratio",
          "type": "number"
        },
        "maximum_pair_candidates": {
          "default": 250000,
          "exclusiveMinimum": 0,
          "title": "Maximum Pair Candidates",
          "type": "integer"
        },
        "maximum_units_per_cohort": {
          "default": 500,
          "exclusiveMinimum": 0,
          "title": "Maximum Units Per Cohort",
          "type": "integer"
        },
        "minimum_independent_groups_for_surrogates": {
          "default": 6,
          "minimum": 3,
          "title": "Minimum Independent Groups For Surrogates",
          "type": "integer"
        },
        "minimum_spearman_units": {
          "default": 3,
          "minimum": 3,
          "title": "Minimum Spearman Units",
          "type": "integer"
        },
        "minimum_top_k_for_jaccard": {
          "default": 5,
          "minimum": 5,
          "title": "Minimum Top K For Jaccard",
          "type": "integer"
        },
        "pair_boundary_epsilon": {
          "default": 1e-12,
          "minimum": 0,
          "title": "Pair Boundary Epsilon",
          "type": "number"
        },
        "primary_top_fraction": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Primary Top Fraction",
          "type": "number"
        },
        "primary_vertical_weight": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Primary Vertical Weight",
          "type": "number"
        },
        "score_tie_decimals": {
          "default": 12,
          "maximum": 14,
          "minimum": 8,
          "title": "Score Tie Decimals",
          "type": "integer"
        },
        "similar_cover_tolerance": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Similar Cover Tolerance",
          "type": "number"
        },
        "top_fractions": {
          "default": [
            0.1,
            0.2,
            0.3
          ],
          "items": {
            "exclusiveMinimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "title": "Top Fractions",
          "type": "array"
        }
      },
      "title": "Comparison",
      "type": "object"
    },
    "Grid": {
      "additionalProperties": false,
      "properties": {
        "epsg": {
          "exclusiveMinimum": 0,
          "title": "Epsg",
          "type": "integer"
        },
        "nodata": {
          "title": "Nodata",
          "type": "number"
        },
        "origin_x": {
          "title": "Origin X",
          "type": "number"
        },
        "origin_y": {
          "title": "Origin Y",
          "type": "number"
        },
        "resolution_m": {
          "exclusiveMinimum": 0,
          "title": "Resolution M",
          "type": "number"
        }
      },
      "required": [
        "epsg",
        "resolution_m",
        "origin_x",
        "origin_y",
        "nodata"
      ],
      "title": "Grid",
      "type": "object"
    },
    "Indicators": {
      "additionalProperties": false,
      "properties": {
        "batch_records": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "maximum": 250000,
          "title": "Batch Records",
          "type": "integer"
        },
        "height_estimand": {
          "const": "normalized_vegetation_returns",
          "default": "normalized_vegetation_returns",
          "title": "Height Estimand",
          "type": "string"
        },
        "include_I8": {
          "const": false,
          "default": false,
          "title": "Include I8",
          "type": "boolean"
        },
        "include_I9_I10": {
          "const": false,
          "default": false,
          "title": "Include I9 I10",
          "type": "boolean"
        },
        "maximum_stored_height_values": {
          "default": 6000000,
          "exclusiveMinimum": 0,
          "title": "Maximum Stored Height Values",
          "type": "integer"
        },
        "maximum_units": {
          "default": 2000,
          "exclusiveMinimum": 0,
          "title": "Maximum Units",
          "type": "integer"
        },
        "quantile_method": {
          "const": "linear",
          "default": "linear",
          "title": "Quantile Method",
          "type": "string"
        }
      },
      "title": "Indicators",
      "type": "object"
    },
    "InputPreparation": {
      "additionalProperties": false,
      "properties": {
        "adversarial_context_policy": {
          "const": "clip_to_tile",
          "default": "clip_to_tile",
          "title": "Adversarial Context Policy",
          "type": "string"
        },
        "download_attempts": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Download Attempts",
          "type": "integer"
        },
        "download_timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Download Timeout Seconds",
          "type": "integer"
        },
        "edge_width_m": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "title": "Edge Width M",
          "type": "number"
        },
        "excluded_noise_classes": {
          "default": [
            7,
            18
          ],
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Excluded Noise Classes",
          "type": "array"
        },
        "grid_code_field": {
          "default": "cd_quadric",
          "title": "Grid Code Field",
          "type": "string"
        },
        "max_new_downloads_per_case": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Max New Downloads Per Case",
          "type": "integer"
        }
      },
      "title": "InputPreparation",
      "type": "object"
    },
    "Paths": {
      "additionalProperties": false,
      "properties": {
        "corridors": {
          "format": "path",
          "title": "Corridors",
          "type": "string"
        },
        "data_root": {
          "format": "path",
          "title": "Data Root",
          "type": "string"
        },
        "downloader_script": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Downloader Script"
        },
        "grid": {
          "format": "path",
          "title": "Grid",
          "type": "string"
        },
        "mount_root": {
          "format": "path",
          "title": "Mount Root",
          "type": "string"
        },
        "output_root": {
          "format": "path",
          "title": "Output Root",
          "type": "string"
        },
        "project_root": {
          "format": "path",
          "title": "Project Root",
          "type": "string"
        },
        "protocol_file": {
          "format": "path",
          "title": "Protocol File",
          "type": "string"
        },
        "runs_root": {
          "format": "path",
          "title": "Runs Root",
          "type": "string"
        },
        "state_file": {
          "format": "path",
          "title": "State File",
          "type": "string"
        }
      },
      "required": [
        "project_root",
        "data_root",
        "mount_root",
        "output_root",
        "runs_root",
        "state_file",
        "corridors",
        "grid",
        "protocol_file"
      ],
      "title": "Paths",
      "type": "object"
    },
    "Pilot": {
      "additionalProperties": false,
      "properties": {
        "adversarial_corridor": {
          "title": "Adversarial Corridor",
          "type": "string"
        },
        "adversarial_tile": {
          "pattern": "^\\d{4}-\\d{3}$",
          "title": "Adversarial Tile",
          "type": "string"
        },
        "context_tiles": {
          "items": {
            "pattern": "^\\d{4}-\\d{3}$",
            "type": "string"
          },
          "title": "Context Tiles",
          "type": "array"
        },
        "core_tiles": {
          "items": {
            "pattern": "^\\d{4}-\\d{3}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Core Tiles",
          "type": "array"
        },
        "corridor_field": {
          "minLength": 1,
          "title": "Corridor Field",
          "type": "string"
        },
        "corridor_id": {
          "minLength": 1,
          "title": "Corridor Id",
          "type": "string"
        },
        "halo_m": {
          "minimum": 0,
          "title": "Halo M",
          "type": "number"
        },
        "measurement_domain": {
          "const": "original_polygon",
          "title": "Measurement Domain",
          "type": "string"
        },
        "sensitivity_tiles": {
          "items": {
            "pattern": "^\\d{4}-\\d{3}$",
            "type": "string"
          },
          "title": "Sensitivity Tiles",
          "type": "array"
        }
      },
      "required": [
        "corridor_field",
        "corridor_id",
        "core_tiles",
        "adversarial_corridor",
        "adversarial_tile",
        "halo_m",
        "measurement_domain"
      ],
      "title": "Pilot",
      "type": "object"
    },
