{
  "$defs": {
    "Failure": {
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "InputRecord": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "title": "InputRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cache_hit": {
      "title": "Cache Hit",
      "type": "boolean"
    },
    "code_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Code Sha256",
      "type": "string"
    },
    "command": {
      "title": "Command",
      "type": "string"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputRecord"
      },
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "items": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "array"
    },
    "run_id": {
      "pattern": "^\\d{8}T\\d{6}Z_[a-f0-9]{10}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_pilot_executed": {
      "const": false,
      "title": "Scientific Pilot Executed",
      "type": "boolean"
    },
    "source_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Run Id"
    },
    "stage": {
      "default": "02",
      "enum": [
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09",
        "10",
        "11",
        "12"
      ],
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "command",
    "status",
    "started_at",
    "finished_at",
    "config",
    "inputs",
    "environment",
    "code_sha256",
    "outputs",
    "cache_hit",
    "scientific_pilot_executed"
  ],
  "title": "RunManifest",
  "type": "object"
}
