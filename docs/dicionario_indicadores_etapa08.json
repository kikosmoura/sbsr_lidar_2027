      "storage_dtype": "object",
      "unit": "atributo"
    },
    "I1": {
      "estimand": "área horizontal da copa candidata / área observada comum",
      "formula": "T/O; null se O=0",
      "meaning": "I1",
      "null": "ausência explícita; consultar campos *_missing_reason/exclusion_reason_*",
      "storage_dtype": "float64",
      "support": "valor físico se O>0; elegibilidade A requer A>=25m² e O/A>=0.95",
      "unit": "fração"
    },
    "I2": {
      "estimand": "estações/seções de largura completa; somente unidade longitudinal elegível",
      "formula": "L_lacuna_observada/L_observável",
      "meaning": "I2",
      "null": "ausência explícita; consultar campos *_missing_reason/exclusion_reason_*",
      "storage_dtype": "object",
      "support": "eixo aceito, A>=25m², O/A>=0.95 e >=95% do comprimento com seções observáveis",
      "unit": "fração de comprimento"
    },
    "I3_branch_m": {
      "estimand": "null com censura externa, sem lacuna associada ou sem elegibilidade",
      "formula": "comprimento completo da lacuna associada à maior interseção local, se não censurada",
      "meaning": "I3_branch_m",
      "null": "ausência explícita; consultar campos *_missing_reason/exclusion_reason_*",
      "storage_dtype": "object",
      "support": "eixo aceito, A>=25m², O/A>=0.95 e >=95% do comprimento com seções observáveis",
      "unit": "m"
    },
