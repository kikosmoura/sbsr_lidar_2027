      "meaning": "I3_local_censored",
      "null": "ausência explícita; consultar campos *_missing_reason/exclusion_reason_*",
      "storage_dtype": "object",
      "unit": "atributo"
    },
    "I3_local_m": {
      "estimand": "censura por corte/suporte mantida; não área sem copa",
      "formula": "max comprimento de interseção de lacuna do ramo com intervalo da unidade",
      "meaning": "I3_local_m",
      "null": "ausência explícita; consultar campos *_missing_reason/exclusion_reason_*",
      "storage_dtype": "object",
      "support": "eixo aceito, A>=25m², O/A>=0.95 e >=95% do comprimento com seções observáveis",
      "unit": "m"
    },
    "I3_local_over_observable_length": {
      "estimand": "mesmo domínio longitudinal elegível",
      "formula": "I3_local_m/L_observável",
      "meaning": "I3_local_over_observable_length",
