      "storage_dtype": "object",
      "support": "eixo aceito, A>=25m², O/A>=0.95 e >=95% do comprimento com seções observáveis",
      "unit": "fração"
    },
    "I4": {
      "estimand": "componentes de copa conectividade congelada, não árvores individuais",
      "formula": "N*10000/O; N=IDs distintos com interseção de área>0; null se O=0",
      "meaning": "I4",
      "null": "ausência explícita; consultar campos *_missing_reason/exclusion_reason_*",
      "storage_dtype": "float64",
      "support": "valor físico se O>0; elegibilidade A requer A>=25m² e O/A>=0.95",
      "unit": "manchas/ha observado"
    },
    "I5": {
      "estimand": "retornos MDS classes 3/4/5, H válido>=limiar, dentro da copa e V",
      "formula": "mean(H)",
      "meaning": "I5",
      "null": "ausência explícita; consultar campos *_missing_reason/exclusion_reason_*",
      "storage_dtype": "float64",
      "support": "T>=minimum_canopy_area_m2 e n>=minimum_vegetation_returns; A+3D exige também elegibilidade A",
      "unit": "m"
    },
    "I6": {
      "estimand": "mesmos retornos de I5; não P95 de células ou árvores",
